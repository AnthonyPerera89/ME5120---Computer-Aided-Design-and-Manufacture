	(uuid "379fe41f-289f-4d17-91f1-e45c6e9e8188")
	(paper "A3")
	(title_block
		(title "Bench Power Supply 3-18 V, 50 mA-1 A (LM723)")
		(date "2026-11-02")
		(rev "A")
		(company "University of Moratuwa - ME5120 CAD&M")
		(comment 1 "Designer: V.N.A. Perera (259110H)")
		(comment 2 "Input 24 V DC adapter; output 3-18 V adjustable; current limit 50 mA-1 A adjustable")
		(comment 3 "Circuit verified in LTspice: SIM01-SIM09")
		(comment 4 "Page: P1 Overview and block diagram")
	)
	(lib_symbols)
	(text "PAGES\nP1 Overview (this page)\nP2 Power_Input: DC jack, PTC fuse F1, reverse diode D3, bulk caps, power LED\nP3 Regulator: LM723, BD139 + TIP3055 pass stage, RSC, voltage-set pot + trimmer, compensation\nP4 Current_Limit: BC547 limiter, BC557B current source, current-set pot\nP5 Output_Meter_Mech: output caps, output terminal, V/A meter header, shunt, heatsink, mounting holes"
		(exclude_from_sim no)
		(at 39.37 240 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1e32d376-61e2-42fc-83f2-41ecb0e63b44")
	)
	(text "Signal flow left to right: 24 V adapter -> input protection -> LM723 regulator + Darlington pass stage -> output.\nGND is common to all sheets (power symbol). "
		(exclude_from_sim no)
		(at 39.37 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "78e54a3a-0ece-4582-a476-7a199a4a73f4")
	)
	(text "VIN  20-28 V, 1.05 A max"
		(exclude_from_sim no)
		(at 108 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "88dc453a-8f3a-4281-b78f-2a605af76fc4")
	)
	(text "OVERVIEW: BLOCK DIAGRAM"
		(exclude_from_sim no)
		(at 39.37 25.4 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8ca8ff9b-1d03-411e-8c4f-3290baa7e4c4")
	)
	(text "POWER BUDGET (worst case)\nInput 24 V adapter: 1.0 A load + LED 2.2 mA + meter 20 mA + LM723 1.4 mA + current source 0.8 mA  =  about 1.03 A  ->  use 24 V / 1.5 A adapter\nQ1 TIP3055: up to 20 W (1 A at 3 V out), ~24 W into a short  ->  heatsink at board edge\nQ4 BD139: <= 0.34 W normal, 0.95 W into a short  ->  copper area\nRSC 0.56 ohm: 0.56 W at 1 A  ->  2 W part\nD3 SS34: 1.04 W only on reverse polarity (until F1 trips)"
		(exclude_from_sim no)
		(at 39.37 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a3096611-6dab-4e35-8ad2-13d269fe72c9")
	)
